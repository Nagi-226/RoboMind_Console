# RoboMind Console 配置示例
# 复制为 robomind-console.ini 放在「当前工作目录」或「exe 所在目录」生效。
# 没有配置文件时全部取默认值（LanChat 转发关闭）。

[lanchat]
# 默认关闭：避免一启动就连不上服务端报错
enabled=false
host=127.0.0.1
port=9001
# target = 接收者数字用户 id（私聊 SendMsg type=5）。
# 群发需 SendGroupMsg(type=16)，未实现。
target=0

# 凭据不写进本文件，只从环境变量读：
#   ROBOMIND_LANCHAT_USER_ID    数字 id（账号需预先用 LanChat 客户端注册）
#   ROBOMIND_LANCHAT_PASSWORD   明文密码，仅登录时用
# 缺任一变量 → sink 保持不启用，不报错。